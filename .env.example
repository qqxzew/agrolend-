# AgroLand server configuration. Copy to .env and fill in. NEVER commit .env. chmod 600 .env
# Secrets are listed here by NAME only; there are no real values in this file.

# ---------------------------------------------------------------- gateway
AGROLAND_PAYMENT_MODE=masumi          # masumi = real Cardano preprod payments. dev-unpaid = DEVELOPERS ONLY, never for a demo
AGROLAND_PUBLIC_URL=https://agroland.example.org
AGROLAND_STATE_DIR=/data/gateway      # SQLite + uploaded documents + pool PDFs: back this directory up
AGROLAND_INTERNAL_KEY=                # random 48 hex chars; shared with the Node Coworker worker (agent/.env)
AGROLAND_TRUST_PROXY=true             # true behind Caddy (reads the client IP from X-Forwarded-For for rate limits); false otherwise
AGROLAND_RATE_SESSIONS_PER_HOUR=30    # workspace creations per client IP
AGROLAND_RATE_ORDERS_PER_HOUR=120     # order creations per workspace
AGROLAND_ADMIN_KEY=                   # reserved for operator tooling

# ---------------------------------------------------------------- internal geo services (random keys, generate with: openssl rand -hex 24)
GEO_DE_INTERNAL_KEY=
GEO_DE_ESCROW_KEY=
GEO_DE_ARCHITECT_KEY=
GEO_IN_INTERNAL_KEY=
GEO_IN_ESCROW_KEY=
GEO_IN_ARCHITECT_KEY=

# ---------------------------------------------------------------- Masumi payment service (seller side)
MPS_URL=http://masumi-payment-service:3001
MPS_RUNTIME_TOKEN=                    # wallet-scoped ReadAndPay key created by `npm run mps:key` (agent/), NOT the admin key
SELLER_VKEY=                          # printed by `npm run register:status`
PAYMENT_SOURCE_INDEX=0
AGENT_IDENTIFIER_LAND_AUDIT=          # printed by `npm run register:status` after the registry transaction confirms
AGENT_IDENTIFIER_LEASE_CHECK=
AGENT_IDENTIFIER_POOL_ACCESS=
BLOCKFROST_API_KEY_PREPROD=           # Blockfrost preprod project id (used to verify transactions independently)

# Optional: a SEPARATE buyer payment service/wallet funded with test USDM so website visitors can pay with a "demo test wallet".
BUYER_MPS_URL=
BUYER_MPS_TOKEN=

# ---------------------------------------------------------------- Masumi payment service stack (docker compose)
POSTGRES_PASSWORD=
ENCRYPTION_KEY=                       # 32+ random characters; losing it makes stored wallets unreadable
ADMIN_KEY=                            # Masumi admin key (admin UI + registration); keep out of the gateway env
SELLING_WALLET_PREPROD_MNEMONIC=      # 24 words of the dedicated seller wallet. Test funds only. Never reuse another project's wallet.
COLLECTION_WALLET_PREPROD_ADDRESS=
