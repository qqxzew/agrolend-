# --- language model (OpenAI-compatible provider). Keep this file private (chmod 600). Never commit it.
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
ZAI_CONTEXT_WINDOW_TOKENS=
# --- local Eve agent
EVE_PORT=21949
EVE_URL=http://127.0.0.1:21949
# --- Sokosumi Coworker (ids come from `sokosumi` CLI output; the runtime key goes into the CLI vault, never here)
COWORKER_ID=
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
PAID_TASKS_ENABLED=false
# --- AgroLand gateway (the shared execution system)
AGROLAND_URL=http://127.0.0.1:8080
AGROLAND_INTERNAL_KEY=
# --- Masumi registration helpers (payment-registration.mjs / register-agents.mjs)
MPS_URL=http://127.0.0.1:38127
AGENT_AUTHOR=
PUBLIC_BASE_URL=
BLOCKFROST_API_KEY_PREPROD=
