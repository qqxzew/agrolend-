# Copy to .env and fill in. Never commit .env (it holds your wallet seed).

# ============================ 1. WHAT YOU ALREADY HAVE ============================
# Blockfrost *Preprod* project key (starts with "preprod")
BLOCKFROST_API_KEY=preprodYourKeyHere

# Your Cardano Preprod wallet = the SELLER wallet that receives the 10 tADA.
# Paste the 24-word seed phrase (the payment service encrypts it in its own database)...
WALLET_SEED_PHRASE="word1 word2 word3 ... word24"
# ...and, recommended, the address that should receive the funds (addr_test1...). Empty = the wallet above.
WALLET_ADDRESS=
# (A bare vkey is not enough: the service needs the seed to sign the result-submission transaction.)

# ============================ 2. MODE ============================
# true  = run the GIS audit immediately, no blockchain (local dev / testing)
# false = real Preprod flow: start_job returns a payment request, /status runs the audit once FundsLocked
BYPASS_PAYMENT=true

# ============================ 3. ONLY NEEDED FOR BYPASS_PAYMENT=false ============================
# Secrets for the payment service stack — make these long and random (openssl rand -hex 32).
ENCRYPTION_KEY=change_me_to_at_least_32_random_characters
ADMIN_KEY=change_me_admin_key_at_least_15_chars
POSTGRES_PASSWORD=postgres

# Token the worker sends to the payment service (`token` header). Easiest: same as ADMIN_KEY;
# better: create a restricted key in the admin UI (http://localhost:3001/admin/).
MASUMI_API_KEY=change_me_admin_key_at_least_15_chars

# Filled in AFTER you register this agent (admin UI -> AI agents -> Register; see README step 3).
AGENT_IDENTIFIER=
# payment-service 0.29 only seeds a V2 contract; docker compose defaults to these two values.
MASUMI_PAYMENT_SOURCE_TYPE=Web3CardanoV2
MASUMI_SUPPORTED_PAYMENT_SOURCE_INDEX=0

# ============================ 4. DEFAULTS (usually untouched) ============================
MASUMI_NETWORK=Preprod
# (docker compose overrides this with the container hostname)
MASUMI_PAYMENT_SERVICE_URL=http://localhost:3001
PRICE_TADA=10
# Unit shown next to the price (display only; the registry entry sets the real price). Sokosumi needs USDM: tUSDM on Preprod.
PRICE_UNIT=tADA
DATABASE_PATH=data/jobs.sqlite3
MAX_AREA_HA=1000

# ============================ 5. AGENT 2 (MATCHER) ============================
# Where Agent 1 runs, and the shared secret the future orchestrator sends as `X-API-Key`
# (empty = no auth, dev only).
VALIDATOR_URL=http://localhost:8000
# Shared secret for Agent 2 (also used by Agent 3). Required by docker compose; openssl rand -hex 24
MATCHER_API_KEY=change_me_matcher_key_at_least_20_chars
MATCHER_DATABASE_PATH=data/matcher.sqlite3

# ============================ 6. AGENT 3 (ESCROW & NDA) ============================
# MATCHER_API_KEY (section 5) is REQUIRED here: Agent 3 reads the un-anonymised match through it.
MATCHER_URL=http://localhost:8001
ESCROW_API_KEY=change_me_escrow_key_at_least_20_chars
ESCROW_DATABASE_PATH=data/escrow.sqlite3
# true = deposits count as locked immediately (testing). false = each developer pays via Masumi Preprod.
ESCROW_BYPASS_PAYMENT=true
# Identifier of the escrow agent after you register it in Masumi (a second agent, separate from Agent 1)
ESCROW_AGENT_IDENTIFIER=
DEPOSIT_TADA=10
# NDA template parameters
PLATFORM_NAME="Flächenpool-Plattform"
NDA_JURISDICTION_CITY=Berlin
NDA_MAX_PENALTY_EUR=50000

# ============================ 7. AGENT 4 (POOL ARCHITECT) ============================
# ESCROW_API_KEY (section 6) is REQUIRED here: Agent 4 reads the revealed deal through it (set it on both sides).
ESCROW_URL=http://localhost:8002
ARCHITECT_API_KEY=
ARCHITECT_DATABASE_PATH=data/architect.sqlite3
# Document parameters (PLATFORM_NAME from section 6 is reused)
POOL_JURISDICTION_CITY=Berlin
POOL_EXCLUSIVITY_MONTHS=24
POOL_TERM_YEARS=30

# ============================ INDIA (wind & solar; Andhra Pradesh + Gujarat) ============================
# Separate agents under india/ with their own variables (IN_*). They share the Masumi payment-service connection
# (MASUMI_*, section 3) with the German stack. Start them with:
#   docker compose -f docker-compose.yml -f india/docker-compose.india.yml up -d --build
# Register the India agents in Masumi as their OWN entries (separate identifiers from the German ones).

# --- India Agent 1 (land audit), port 9000 ---
IN_AUDIT_BYPASS_PAYMENT=true
IN_AUDIT_AGENT_IDENTIFIER=
IN_AUDIT_PRICE_TADA=10
IN_AUDIT_MAX_AREA_HA=1000
IN_AUDIT_DATABASE_PATH=data/in_jobs.sqlite3
# The free Open-Meteo API is for NON-commercial use only. For a commercial service set a paid key here.
IN_AUDIT_OPEN_METEO_API_KEY=
# Fixed ERA5 reference period for the 100 m wind mean (keeps reports reproducible)
IN_AUDIT_WIND_START_DATE=2022-01-01
IN_AUDIT_WIND_END_DATE=2024-12-31
# Shared secret that lets India Agent 2 request unpaid audits (POST /internal/audit); same value as IN_MATCHER_API_KEY
IN_AUDIT_INTERNAL_API_KEY=change_me_in_matcher_key_at_least_20_chars

# --- India Agent 2 (matcher), port 9001 ---
IN_MATCHER_VALIDATOR_URL=http://localhost:9000
IN_MATCHER_VALIDATOR_API_KEY=change_me_in_matcher_key_at_least_20_chars
IN_MATCHER_API_KEY=change_me_in_matcher_key_at_least_20_chars
IN_MATCHER_DATABASE_PATH=data/in_matcher.sqlite3

# --- India Agent 3 (escrow & NDA), port 9002 ---
IN_ESCROW_MATCHER_URL=http://localhost:9001
IN_ESCROW_MATCHER_API_KEY=change_me_in_matcher_key_at_least_20_chars
IN_ESCROW_API_KEY=change_me_in_escrow_key_at_least_20_chars
IN_ESCROW_DATABASE_PATH=data/in_escrow.sqlite3
IN_ESCROW_BYPASS_PAYMENT=true
IN_ESCROW_AGENT_IDENTIFIER=
IN_ESCROW_DEPOSIT_TADA=10
# NDA template parameters (English, Indian law); have an Indian advocate review the template before production
IN_ESCROW_PLATFORM_NAME="India Land Pooling Platform"
IN_ESCROW_ARBITRATION_SEAT=New Delhi
IN_ESCROW_COURT_CITY=New Delhi
# Cap per breach under s.74 Indian Contract Act (reasonable compensation), INR
IN_ESCROW_NDA_MAX_COMPENSATION_INR=2500000

# --- India Agent 4 (pool architect), port 9003 ---
IN_ARCHITECT_ESCROW_URL=http://localhost:9002
IN_ARCHITECT_ESCROW_API_KEY=change_me_in_escrow_key_at_least_20_chars
IN_ARCHITECT_API_KEY=
IN_ARCHITECT_DATABASE_PATH=data/in_architect.sqlite3
# Document parameters (Land Pooling Agreement)
IN_ARCHITECT_PLATFORM_NAME="India Land Pooling Platform"
IN_ARCHITECT_ARBITRATION_SEAT=New Delhi
